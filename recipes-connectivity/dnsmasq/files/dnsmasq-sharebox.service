[Unit]
Description=ShareBox DHCP and wildcard DNS server (dnsmasq)
Requires=sharebox-setup.service
After=sharebox-setup.service nftables.service systemd-networkd.service sys-subsystem-net-devices-wlan0.device
BindsTo=sys-subsystem-net-devices-wlan0.device

[Service]
Type=simple
EnvironmentFile=/run/sharebox/env
ExecStartPre=/usr/bin/dnsmasq --test --conf-file=/run/sharebox/dnsmasq.conf
ExecStart=/usr/bin/dnsmasq --keep-in-foreground --conf-file=/run/sharebox/dnsmasq.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
# Lease file in /run/dnsmasq (tmpfiles, owned by dnsmasq): volatile on
# purpose, no client history is kept on the box.

# Hardening: starts as root to bind 53/67, then dnsmasq drops to user
# "dnsmasq" ("user=" in the generated configuration), keeping only
# CAP_NET_ADMIN (ARP cache for DHCP replies) and CAP_NET_RAW (ping check).
# CAP_DAC_OVERRIDE only lets the root phase open the lease file in the
# dnsmasq-owned /run/dnsmasq; dnsmasq drops it with the user switch.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX AF_PACKET
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
ReadWritePaths=/run/dnsmasq

[Install]
WantedBy=multi-user.target
