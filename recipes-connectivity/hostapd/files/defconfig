# hostapd build configuration for ShareBox (open access point only)
#
# Open network with ap_isolate: no WPA authenticator features beyond what
# hostapd always builds, no 802.1X/EAP/RADIUS, no WPS, no Wi-Fi 6/7.
# CONFIG_IEEE80211BE stays off (no Wi-Fi 7 on the Pi, CVE-2026-58374 does
# not apply).

CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y

# 802.11n is always built; 802.11ac for the optional 5 GHz mode
CONFIG_IEEE80211AC=y

# Smaller attack surface
CONFIG_NO_RADIUS=y
CONFIG_NO_ACCOUNTING=y
CONFIG_NO_VLAN=y
CONFIG_NO_DUMP_STATE=y

# Control interface kept (root only, /run/hostapd) for hostapd_cli debugging
