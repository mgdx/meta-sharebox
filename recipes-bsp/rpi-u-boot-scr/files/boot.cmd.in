# ShareBox A/B boot script for U-Boot (RAUC "uboot" bootloader backend).
# Derived from meta-rauc-raspberrypi recipes-bsp/rpi-u-boot-scr/files/boot.cmd.in
# (meta-rauc-community, MIT).
#
# Environment (uboot.env on the boot partition, shared with fw_setenv):
#   BOOT_ORDER   slots to try, in order ("A B" or "B A"), set by RAUC
#   BOOT_A_LEFT  remaining boot attempts of slot A, reset to 3 by
#   BOOT_B_LEFT  "rauc status mark-good" (sharebox-healthcheck)
# Each boot decrements the counter of the slot it picks; a slot whose counter
# reaches 0 is skipped, so after 3 boots without mark-good the other slot is
# used. Slot B is empty until the first update, hence BOOT_B_LEFT defaults to 0.
# The kernel is /boot/@@KERNEL_IMAGETYPE@@ inside the erofs slot (U-Boot
# CONFIG_FS_EROFS); the device tree is the one prepared by the firmware.

fdt addr ${fdt_addr} && fdt get value bootargs /chosen bootargs

test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B"
test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3
test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 0

setenv bootpart
setenv raucslot
setenv bootdev

for BOOT_SLOT in "${BOOT_ORDER}"; do
  if test "x${bootpart}" != "x"; then
    # a slot was already selected, skip the remaining ones
  elif test "x${BOOT_SLOT}" = "xA"; then
    if itest ${BOOT_A_LEFT} -gt 0; then
      setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1
      echo "ShareBox: booting slot A (${BOOT_A_LEFT} attempts left)"
      setenv bootpart "@@ROOT_A_DEVICE@@"
      setenv raucslot "A"
      setenv bootdev "@@UBOOT_DISK@@:@@ROOT_A_PARTNUM@@"
    fi
  elif test "x${BOOT_SLOT}" = "xB"; then
    if itest ${BOOT_B_LEFT} -gt 0; then
      setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1
      echo "ShareBox: booting slot B (${BOOT_B_LEFT} attempts left)"
      setenv bootpart "@@ROOT_B_DEVICE@@"
      setenv raucslot "B"
      setenv bootdev "@@UBOOT_DISK@@:@@ROOT_B_PARTNUM@@"
    fi
  fi
done

if test -n "${bootpart}"; then
  setenv bootargs "${bootargs} root=${bootpart} rauc.slot=${raucslot}"
  saveenv
else
  echo "ShareBox: no slot has boot attempts left, resetting the counters"
  setenv BOOT_A_LEFT 3
  setenv BOOT_B_LEFT 3
  saveenv
  reset
fi

if load ${bootdev} ${kernel_addr_r} boot/@@KERNEL_IMAGETYPE@@; then
  @@KERNEL_BOOTCMD@@ ${kernel_addr_r} - ${fdt_addr}
fi

# Only reached when the slot has no loadable kernel (empty or damaged slot):
# give up on it right away and try the other one.
echo "ShareBox: cannot boot slot ${raucslot}, disabling it"
setenv BOOT_${raucslot}_LEFT 0
saveenv
reset
