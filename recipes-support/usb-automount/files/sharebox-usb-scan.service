[Unit]
Description=ShareBox USB stick scan (shared content, configuration, hooks)
After=sharebox-setup.service local-fs.target media.mount
Wants=media.mount

[Service]
Type=oneshot
ExecStart=/usr/lib/sharebox/sharebox-usb-scan
TimeoutStartSec=120

# Hardening. Root is needed to restart sharebox-setup through systemd and
# to write /data/config; no capability is kept.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0022
ReadOnlyPaths=/media
ReadWritePaths=-/data/share -/data/config -/run/sharebox
