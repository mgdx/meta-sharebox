[Unit]
Description=ShareBox USB stick scan (shared content, configuration, hooks)
After=sharebox-setup.service local-fs.target media.mount
Wants=media.mount

[Service]
Type=oneshot
ExecStart=/usr/lib/sharebox/sharebox-usb-scan
TimeoutStartSec=120

# Hardening. Root (uid 0, no capability kept) is needed to restart units
# through systemd's private socket (sharebox-setup here, kiwix-library-update
# in the 60-kiwix hook) and to write the root-owned /data/share (usb link),
# /data/config and /run/sharebox (update-candidate of the 50-rauc hook).
# Without CAP_DAC_OVERRIDE, those directories must stay owned by root.
# "rauc info" (50-rauc) is local: it reads the keyring, system.conf and
# /data/rauc (root, 0700) and only needs AF_UNIX; it does not mount the
# verity bundle, so PrivateDevices= does not get in the way.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0022
ReadOnlyPaths=/media
ReadWritePaths=-/data/share -/data/config -/run/sharebox
