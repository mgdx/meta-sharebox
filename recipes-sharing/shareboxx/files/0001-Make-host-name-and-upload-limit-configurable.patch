From: meta-sharebox maintainers <leo@magacyber.fr>
Subject: [PATCH] Make host name and upload limit configurable, harden uploads

- SHAREBOXX_HOSTNAME selects the canonical host name every other host is
  redirected to (default: shareboxx.lan, as before).
- SHAREBOXX_UPLOAD_MAX sets the multipart size limit in bytes (default:
  10 GiB, as before; 0 rejects every upload).
- Reject uploads whose upload_path or file name is absolute or contains a
  ".." component: they were joined to ./files unchecked, which allowed
  writing outside the shared folder.
- Call "df -P -k" instead of the GNU only "--output" option so that the
  disk usage also works with busybox df.

Upstream-Status: Pending
Signed-off-by: meta-sharebox maintainers <leo@magacyber.fr>
---
--- a/src/app.rs
+++ b/src/app.rs
@@ -475,8 +475,10 @@
 
 #[server]
 pub async fn get_disk_space() -> Result<(u64, u64), ServerFnError> {
+    // POSIX output in 1024-byte blocks, understood by both GNU coreutils
+    // and busybox df.
     let output = std::process::Command::new("df")
-        .args(["--output=size,avail", "-B1", "./files"])
+        .args(["-P", "-k", "./files"])
         .output()
         .map_err(|e| sfn_err(format!("df failed: {}", e)))?;
     let stdout = String::from_utf8_lossy(&output.stdout);
@@ -490,8 +492,11 @@
             "Invalid df output".to_string(),
         ));
     }
-    let total: u64 = parts[0].parse().unwrap_or(0);
-    let avail: u64 = parts[1].parse().unwrap_or(0);
+    if parts.len() < 4 {
+        return Err(sfn_err("Invalid df output".to_string()));
+    }
+    let total: u64 = parts[1].parse::<u64>().unwrap_or(0) * 1024;
+    let avail: u64 = parts[3].parse::<u64>().unwrap_or(0) * 1024;
     Ok((total.saturating_sub(avail), total))
 }
 
--- a/src/main.rs
+++ b/src/main.rs
@@ -17,6 +17,39 @@
 #[cfg(feature = "ssr")]
 use shareboxx::app::App;
 
+/// Canonical host name the server redirects every other host to. Set with
+/// SHAREBOXX_HOSTNAME, defaults to the upstream "shareboxx.lan".
+#[cfg(feature = "ssr")]
+fn canonical_host() -> &'static str {
+    static HOST: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    HOST.get_or_init(|| {
+        std::env::var("SHAREBOXX_HOSTNAME")
+            .ok()
+            .filter(|h| !h.trim().is_empty())
+            .unwrap_or_else(|| "shareboxx.lan".to_string())
+    })
+}
+
+/// Maximum size of one upload request in bytes. Set with
+/// SHAREBOXX_UPLOAD_MAX, defaults to 10 GiB; 0 rejects every upload.
+#[cfg(feature = "ssr")]
+fn upload_limit() -> usize {
+    std::env::var("SHAREBOXX_UPLOAD_MAX")
+        .ok()
+        .and_then(|v| v.trim().parse::<usize>().ok())
+        .unwrap_or(10 * 1024 * 1024 * 1024)
+}
+
+/// Accept only relative paths without "..", so an upload cannot escape
+/// the files directory.
+#[cfg(feature = "ssr")]
+fn is_safe_relative(path: &str) -> bool {
+    !path.starts_with('/')
+        && !path.contains('\\')
+        && !path.contains('\0')
+        && path.split('/').all(|c| c != "..")
+}
+
 #[cfg(feature = "ssr")]
 #[actix_web::main]
 async fn main() -> std::io::Result<()> {
