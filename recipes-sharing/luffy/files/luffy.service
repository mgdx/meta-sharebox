[Unit]
Description=Luffy PirateBox compatible file sharing, chat and forum
Documentation=https://github.com/et0and/luffy
After=sharebox-setup.service network.target
Requires=sharebox-setup.service

[Service]
Type=simple
EnvironmentFile=/run/sharebox/env
# The configuration lives in a per-service runtime directory, regenerated
# from /run/sharebox/env at every start.
RuntimeDirectory=sharebox/luffy
RuntimeDirectoryMode=0750
ExecStartPre=@LIBEXECDIR@/luffy/luffy-gen-config /run/sharebox/luffy/piratebox.conf
# "serve" runs the web server only: luffy must not touch interfaces, hostapd,
# dnsmasq or the firewall, which belong to the ShareBox base system.
ExecStart=@BINDIR@/luffy --config /run/sharebox/luffy/piratebox.conf serve
Restart=on-failure
RestartSec=5s
LimitNOFILE=1024

User=sharebox
Group=sharebox
WorkingDirectory=/data/luffy

# Port 80 is the only privilege luffy needs.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077
# AF_INET6 for the dual-stack listener, AF_NETLINK for "iw station dump"
# (connected clients counter), AF_UNIX for logging.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed

# /data/luffy holds luffy's state (chat, forum, web content), uploads land
# in /data/share/upload, the rest of /data/share is listed read-only.
ReadWritePaths=/data/luffy -/data/share/upload
ReadOnlyPaths=-/data/share -/media

[Install]
WantedBy=multi-user.target
