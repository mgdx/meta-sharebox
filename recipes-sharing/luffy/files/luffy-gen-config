#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Generate the luffy (PirateBox compatible) configuration from the ShareBox
# runtime environment. Run by luffy.service as ExecStartPre, as the
# unprivileged sharebox user, with /run/sharebox/env already loaded into the
# environment by EnvironmentFile=.
#
# Usage: luffy-gen-config <output file>
#
# Key order matters: the defaults derived from /run/sharebox/env come first,
# then an optional site file (/etc/piratebox/piratebox.conf) may override
# cosmetic settings, and the keys that must match the systemd sandbox and
# the ShareBox base system (paths, ports, no network management) come last.

set -eu

out="${1:-/run/sharebox/luffy/piratebox.conf}"
site_conf="/etc/piratebox/piratebox.conf"

host="${SHAREBOX_HOSTNAME:-sharebox.lan}"
addr="${SHAREBOX_ADDR:-192.168.77.1}"
upload_max="${SHAREBOX_UPLOAD_MAX:-2147483648}"

# Strip a possible prefix length ("192.168.77.1/24").
addr="${addr%%/*}"
net="${addr%.*}"
ip_short="${addr##*.}"

# Only digits are accepted for the upload limit; anything else falls back to
# the build default of 2 GiB.
case "$upload_max" in
    ''|*[!0-9]*) upload_max=2147483648 ;;
esac

if [ "$upload_max" -eq 0 ]; then
    droopy_enabled="no"
    upload_mb=0
else
    droopy_enabled="yes"
    # luffy counts in MiB; round up so that tiny limits stay non-zero.
    upload_mb=$(( (upload_max + 1048575) / 1048576 ))
fi

tmp="${out}.tmp"
umask 0027
{
    echo "# Generated by luffy-gen-config from /run/sharebox/env. Do not edit."
    echo "HOST=\"${host}\""
    echo "IP=\"${addr}\""
    echo "NET=\"${net}\""
    echo "IP_SHORT=\"${ip_short}\""
    echo "INTERFACE=\"wlan0\""
    echo "UPLOAD_MAX_SIZE_MB=\"${upload_mb}\""
    echo "DROOPY_ENABLED=\"${droopy_enabled}\""
    if [ -r "$site_conf" ]; then
        echo ""
        echo "# Site customisation"
        echo ". ${site_conf}"
    fi
    echo ""
    echo "# Enforced by meta-sharebox: data layout below /data"
    echo "PIRATEBOX_FOLDER=\"/data/luffy\""
    echo "WWW_FOLDER=\"/data/luffy/www\""
    echo "WWW_CONTENT=\"/data/luffy/content\""
    echo "SHARE_FOLDER=\"/data/luffy/share\""
    echo "UPLOADFOLDER=\"/data/share/upload\""
    echo "DIRLIST_FOLDER=\"/data/share\""
    echo "NODE_CONFIG=\"/data/luffy/conf/node.conf\""
    echo ""
    echo "# Enforced by meta-sharebox: hostapd, dnsmasq, nftables and"
    echo "# systemd-networkd own the network, luffy only serves HTTP on port 80."
    echo "DO_IFCONFIG=\"no\""
    echo "DO_IW=\"no\""
    echo "PROBE_INTERFACE=\"no\""
    echo "USE_APN=\"no\""
    echo "USE_DNSMASQ=\"no\""
    echo "DO_BRIDGE=\"no\""
    echo "IPV6_ENABLE=\"no\""
    echo "FIREWALL_FETCH_DNS=\"no\""
    echo "FIREWALL_FETCH_HTTP=\"no\""
    echo "NODE_CONFIG_ACTIVE=\"no\""
    echo "GLOBAL_CHAT=\"no\""
    echo "ENABLE_IRC_SERVER=\"no\""
    echo "HTTP_ADDR=\"\""
    echo "HTTP_PORT=\"80\""
    echo "# Uploads are served on port 80 under /upload/ only."
    echo "DROOPY_PORT=\"0\""
} > "$tmp"
mv -f "$tmp" "$out"
