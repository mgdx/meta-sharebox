+	shared := dirlist.New(s.opts.Cfg.DirlistFolder, "/Shared")
+
+	// The droopy compatible upload form is also served on the main
+	// listener, so uploads work when only one HTTP port is reachable.
+	if s.opts.Cfg.DroopyEnabled {
+		upload := s.uploadHandler()
+		mux.Handle("/upload/", http.StripPrefix("/upload", upload))
+		mux.Handle("/upload", http.RedirectHandler("/upload/", http.StatusMovedPermanently))
+	}
 
 	mux.HandleFunc("/cgi-bin/psowrte.py", s.handleShoutboxWrite)
 	mux.HandleFunc("/cgi-bin/psoread.py", s.handleShoutboxRead)
