#!/bin/sh
# Start the writable dufs instance (dufs.service, 127.0.0.1:5000).
#
# modular engine: dufs serves the whole public share at /files/. Everybody
#   can browse, search and download /data/share; anonymous uploads go to
#   /data/share/upload only (access rule "/upload:rw").
# full engine: the public share is served read-only by dufs-ro at /files/;
#   this instance only serves the upload directory, at /upload/.
#
# Uploads are disabled entirely when SHAREBOX_UPLOAD_MAX is 0. Nothing can be
# deleted, moved or overwritten: --allow-delete is never passed. The upload
# size limit itself is enforced by lighttpd (server.max-request-size).
set -eu

upload="--allow-upload"
if [ "${SHAREBOX_UPLOAD_MAX:-1}" = "0" ]; then
	upload=""
fi

case "${SHAREBOX_ENGINE:-modular}" in
full)
	prefix=/upload
	auth='@/:rw'
	root=/data/share/upload
	;;
*)
	prefix=/files
	auth='@/,/upload:rw'
	root=/data/share
	;;
esac

# shellcheck disable=SC2086
exec /usr/bin/dufs \
	$upload \
	--allow-search \
	--allow-archive \
	--allow-symlink \
	--auth "$auth" \
	--hidden '.*' \
	--path-prefix "$prefix" \
	--bind 127.0.0.1 \
	--port 5000 \
	"$root"
