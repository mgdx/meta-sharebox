[Unit]
Description=dufs file server, read-only (ShareBox library and full engines)
Documentation=https://github.com/sigoden/dufs
After=sharebox-setup.service local-fs.target
Requires=sharebox-setup.service
RequiresMountsFor=/data/share

[Service]
Type=simple
User=sharebox
Group=sharebox
EnvironmentFile=/run/sharebox/env
# No --allow-upload and no --allow-delete: browse, search and download only
ExecStart=/usr/bin/dufs --allow-search --allow-archive --allow-symlink --hidden .* --path-prefix /files --bind 127.0.0.1 --port 5001 /data/share
Restart=on-failure
RestartSec=2s

# Sandboxing (docs/ARCHITECTURE.md, "systemd unit hardening")
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/data/share

[Install]
WantedBy=multi-user.target
