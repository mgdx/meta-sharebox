[Unit]
Description=dufs file server (ShareBox public share and anonymous upload)
Documentation=https://github.com/sigoden/dufs
After=sharebox-setup.service local-fs.target
Requires=sharebox-setup.service
RequiresMountsFor=/data/share

[Service]
Type=simple
User=sharebox
Group=sharebox
EnvironmentFile=/run/sharebox/env
# Options and access rules are in dufs-start (uploads only into upload/)
ExecStart=/usr/libexec/dufs/dufs-start
Restart=on-failure
RestartSec=2s

# Sandboxing (docs/ARCHITECTURE.md, "systemd unit hardening")
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# Uploads are owned by sharebox; dufs-ro runs as the same user
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/data/share
ReadWritePaths=/data/share/upload

[Install]
WantedBy=multi-user.target
