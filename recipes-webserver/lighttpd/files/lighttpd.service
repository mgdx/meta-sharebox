[Unit]
Description=ShareBox HTTP front end (lighttpd)
Requires=sharebox-setup.service
After=sharebox-setup.service nftables.service network.target

[Service]
Type=simple
EnvironmentFile=/run/sharebox/env
ExecStartPre=@SBINDIR@/lighttpd -tt -f @SYSCONFDIR@/lighttpd/lighttpd.conf
ExecStart=@SBINDIR@/lighttpd -D -f @SYSCONFDIR@/lighttpd/lighttpd.conf
ExecReload=@SBINDIR@/lighttpd -tt -f @SYSCONFDIR@/lighttpd/lighttpd.conf
ExecReload=@BASE_BINDIR@/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=2

# Hardening: unprivileged user, only allowed to bind port 80
User=www
Group=www
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
ReadOnlyPaths=-/data/share
# /status queues update requests here (sharebox-install-update, directory
# root:www 0730, watched by sharebox-update-install.path)
ReadWritePaths=-/run/sharebox/requests

[Install]
WantedBy=multi-user.target
