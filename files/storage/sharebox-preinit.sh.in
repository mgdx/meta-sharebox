#!/bin/sh
# ShareBox early init: runs as PID 1 before systemd (installed as /sbin/init,
# systemd is /sbin/init.orig).
#
# Generated by oe-core overlayfs-etc.bbclass from meta-sharebox
# files/storage/sharebox-preinit.sh.in, a Python str.format() template:
# literal braces are doubled. Derived from oe-core
# meta/files/overlayfs-etc-preinit.sh.in (MIT).
#
# - checks and mounts the persistent data partition on {OVERLAYFS_ETC_MOUNT_POINT}
# - mounts /etc and /var as overlays: the read-only erofs root is the lower
#   layer, the upper layers live in {OVERLAYFS_ETC_MOUNT_POINT}/overlay/{{etc,var}}
# - after a system update, drops the persistent copies of the account
#   databases so that users added by the new image are not hidden
# - when the data partition cannot be used, falls back to a RAM-backed
#   {OVERLAYFS_ETC_MOUNT_POINT} so that the box still boots (nothing persists)
#
# The root filesystem is read-only: nothing here may write outside /dev,
# /proc and {OVERLAYFS_ETC_MOUNT_POINT}.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

DATA_DEV="{OVERLAYFS_ETC_DEVICE}"
DATA_MNT="{OVERLAYFS_ETC_MOUNT_POINT}"
DATA_FS="{OVERLAYFS_ETC_FSTYPE}"
DATA_OPTS="{OVERLAYFS_ETC_MOUNT_OPTIONS}"
OVERLAY_BASE="$DATA_MNT/overlay"
FALLBACK_FLAG="$DATA_MNT/.sharebox-data-fallback"
# Account databases reset from the image after an update
ACCOUNT_FILES="passwd group shadow gshadow subuid subgid"

log() {{
    echo "sharebox-preinit: $*" > /dev/kmsg 2>/dev/null || echo "sharebox-preinit: $*"
}}

mount -t proc proc /proc
# Normally already mounted by the kernel (CONFIG_DEVTMPFS_MOUNT)
[ -c /dev/null ] || mount -t devtmpfs devtmpfs /dev

# The data partition is on the boot disk, which the kernel already waited
# for (rootwait); give udev-less partition scanning a few seconds anyway.
i=0
while [ ! -b "$DATA_DEV" ] && [ "$i" -lt 10 ]; do
    sleep 1
    i=$((i + 1))
done

data_ok=0
if [ -b "$DATA_DEV" ]; then
    case "$DATA_FS" in
    ext2|ext3|ext4)
        if command -v e2fsck > /dev/null 2>&1; then
            # The Raspberry Pi has no RTC: do not let the clock trigger
            # full checks (see /usr/lib/sharebox/e2fsck.conf).
            E2FSCK_CONFIG=/usr/lib/sharebox/e2fsck.conf e2fsck -p "$DATA_DEV"
            rc=$?
            if [ "$rc" -ge 4 ]; then
                log "e2fsck could not repair $DATA_DEV (exit $rc), trying to mount it anyway"
            fi
        fi
        ;;
    esac
    if mount -t "$DATA_FS" -o "$DATA_OPTS" "$DATA_DEV" "$DATA_MNT"; then
        data_ok=1
    else
        log "cannot mount $DATA_DEV on $DATA_MNT"
    fi
else
    log "data partition $DATA_DEV not found"
fi

if [ "$data_ok" != 1 ]; then
    log "using a RAM-backed $DATA_MNT: changes will be lost at reboot"
    mount -t tmpfs -o mode=0755,nodev,nosuid,size=64m tmpfs "$DATA_MNT"
    : > "$FALLBACK_FLAG"
else
    rm -f "$FALLBACK_FLAG"
fi

mkdir -p "$OVERLAY_BASE"
chmod 0700 "$OVERLAY_BASE"

# After an update (new /etc/timestamp in the image), forget the persistent
# copies of the account databases: the new image may add system users.
if [ -f /etc/timestamp ] && [ -d "$OVERLAY_BASE/etc/upper" ]; then
    if [ "$(cat /etc/timestamp)" != "$(cat "$OVERLAY_BASE/etc/image-timestamp" 2>/dev/null)" ]; then
        for f in $ACCOUNT_FILES; do
            rm -f "$OVERLAY_BASE/etc/upper/$f" "$OVERLAY_BASE/etc/upper/$f-"
        done
        log "new system image, account databases reset from the image"
    fi
fi
[ -f /etc/timestamp ] && mkdir -p "$OVERLAY_BASE/etc" && cat /etc/timestamp > "$OVERLAY_BASE/etc/image-timestamp"

for dir in etc var; do
    upper="$OVERLAY_BASE/$dir/upper"
    work="$OVERLAY_BASE/$dir/work"
    mkdir -p "$upper" "$work"
    if ! mount -t overlay \
        -o "lowerdir=/$dir,upperdir=$upper,workdir=$work,index=off,xino=off,redirect_dir=off,metacopy=off" \
        overlay "/$dir"; then
        log "mounting the /$dir overlay failed, /$dir stays read-only"
    fi
done

umount /proc

exec {SBIN_INIT_NAME} "$@"
